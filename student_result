CREATE TABLE student_results (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    math INT,
    science INT,
    english INT
);
INSERT INTO student_results VALUES
(1, 'Rahul', 85, 90, 88),
(2, 'Priya', 92, 95, 90),
(3, 'Arjun', 70, 75, 68),
(4, 'Sneha', 88, 82, 91),
(5, 'Kiran', 55, 60, 58);
SELECT
    name,
    math,
    science,
    english,
    math + science + english AS total,
    (math + science + english) / 3.0 AS average
FROM student_results;
SELECT
    name,
    math + science + english AS total
FROM student_results
ORDER BY total DESC;
SELECT
    name,
    CASE
        WHEN math >= 40
         AND science >= 40
         AND english >= 40
        THEN 'PASS'
        ELSE 'FAIL'
    END AS result
FROM student_results;

